{
  "manifest_version": 3,
  "name": "ZFlow Batcher",
  "version": "1.0.0",
  "description": "Batch prompt automation for Google Flow: queue TXT/CSV prompts, auto-generate, auto-download. Fully local, no accounts, no license checks.",
  "icons": {
    "16": "icons/icon_16.png",
    "48": "icons/icon_48.png",
    "128": "icons/icon_128.png"
  },
  "permissions": [
    "sidePanel",
    "storage",
    "activeTab",
    "tabs",
    "downloads",
    "clipboardRead"
  ],
  "host_permissions": [
    "https://flow.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open ZFlow Batcher",
    "default_icon": {
      "16": "icons/icon_16.png",
      "48": "icons/icon_48.png",
      "128": "icons/icon_128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/panel.html"
  },
  "content_scripts": [
    {
      "matches": ["https://flow.google.com/*"],
      "js": [
        "content/utils.js",
        "content/selectors.js",
        "content/typewriter.js",
        "content/popover.js",
        "content/monitor.js",
        "content/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
